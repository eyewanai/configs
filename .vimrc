set nocompatible
syntax on
filetype plugin indent on

set tabstop=2
set shiftwidth=2
set softtabstop=2
set expandtab
set autoindent
set smartindent
set number
set ruler
set signcolumn=auto
highlight SignColumn ctermbg=NONE guibg=NONE
set scrolloff=5
set splitbelow
set splitright

set hlsearch
set incsearch
set ignorecase
set smartcase
nnoremap <silent> <Esc> :nohlsearch<CR>
